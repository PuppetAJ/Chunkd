{
  "compilerOptions": {
    // Vite compiles the code, so TypeScript is only used for checking.
    "noEmit": true,

    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Imports name the file they mean, extension included, the same way the
    // server's do. Vite resolves them; TypeScript only needs permission to
    // read them, which is safe here because it never emits JavaScript.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],

    // The app is being converted to TypeScript one area at a time. Files that
    // are still .jsx keep working; they are simply not type-checked yet.
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    // shadcn/ui generates components that import each other as "@/components/…".
    // The alias points that prefix at src/, and vite.config.ts repeats it so the
    // bundler resolves it the same way TypeScript does. Our own files keep using
    // relative paths; this exists so generated components work unmodified.
    // (TypeScript 7 removed baseUrl; "paths" is now resolved relative to this
    // file, which is what we want anyway.)
    "paths": {
      "@/*": ["./src/*"]
    },

    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "vite.config.ts"]
}
