# The docker-compose.yml container locally, the MongoDB Atlas connection string in production.
MONGODB_URI=mongodb://127.0.0.1:27017/chunkd

# Generate with node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-generated-secret

# A jsonwebtoken duration, such as 2h or 60s.
JWT_EXPIRES_IN=2h

# .railway/railway.ts sets it in production.
PORT=3001

# The site's public URL in production, the Vite dev server's address locally.
CLIENT_ORIGIN=http://localhost:3000
