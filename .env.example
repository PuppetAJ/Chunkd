# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.

# ---- Server ----

# Local development uses the Mongo container from docker-compose.yml.
# In production this is the MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/chunkd

# Signing key for auth tokens. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-generated-secret

# How long an auth token stays valid.
JWT_EXPIRES_IN=2h

# Port the API listens on.
PORT=3001

# Origin allowed to call the API from a browser. Only used outside development,
# where the Vite dev server proxies requests instead.
CLIENT_ORIGIN=http://localhost:3000
